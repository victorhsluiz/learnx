# Copy this file to .env and fill in real values.
# See src/core/config/env.ts for validation rules.

NODE_ENV=development

# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://user:password@localhost:5432/learnx?schema=public"

# Separate database used by the "integration" Vitest project. Falls back to
# DATABASE_URL if not set, but a dedicated test database is recommended so
# integration tests never touch development data.
TEST_DATABASE_URL="postgresql://user:password@localhost:5432/learnx_test?schema=public"

# Secrets used to sign JWT access/refresh tokens. Must be at least 32
# characters long. Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET="replace-with-a-long-random-secret-min-32-chars"
JWT_REFRESH_SECRET="replace-with-another-long-random-secret-min-32"

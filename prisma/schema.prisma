generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// A LearnX account. The app is single-user per account: every domain
/// record (lessons, words, notes, study tasks, ...) is scoped to a userId.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  refreshTokens RefreshToken[]
  lessons       Lesson[]

  @@map("users")
}

/// A rotating refresh token issued on login. Only the hash is stored;
/// the raw token is only ever sent to the client. Revoked/rotated tokens
/// are kept for audit instead of being deleted.
model RefreshToken {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  userId     String
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  revokedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

enum LessonType {
  RECORDED
  LIVE
}

enum LessonStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

/// A course lesson (recorded or live). Words and notes can optionally
/// reference the lesson they came from.
model Lesson {
  id              String       @id @default(cuid())
  userId          String
  title           String
  type            LessonType
  status          LessonStatus @default(PENDING)
  sourceUrl       String?
  scheduledAt     DateTime?
  watchedAt       DateTime?
  durationMinutes Int?
  tags            String[]     @default([])
  position        Int?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, status])
  @@map("lessons")
}
